# Server-side: where Next.js forwards /api/backend/* (see next.config.mjs rewrites).
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Leave unset to use the same-origin proxy (recommended — no CORS in the browser).
# Set only if you call the API directly from the browser and have fixed CORS:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
