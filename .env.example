APP_NAME=Ops Copilot
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
# FAISS defaults to <repo>/data/index/* (ignores the two lines below). Set true only if the index
# lives outside this repo — otherwise a bad absolute VECTOR_INDEX_PATH often yields index_size: 1.
USE_ENV_VECTOR_INDEX_PATHS=false
VECTOR_INDEX_PATH=data/index/faiss.index
METADATA_PATH=data/index/metadata.json
DOCS_DIR=data/docs

AWS_REGION=us-east-1
# Local dev only (never commit real values). On EC2 prefer an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

S3_DOCS_BUCKET=ops-copilot-docs
S3_ARTIFACTS_BUCKET=ops-copilot-artifacts

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Permissive local dev (not for production): CORS_ORIGINS=*

# --- Docker (docker compose) ---
# Copy this file to .env in the repo root. Compose loads it for the API container.
# Set ENVIRONMENT=production in compose overrides; for CORS when users hit the API from a browser
# on another origin, list those origins here (e.g. https://app.example.com).
# The Next.js container uses BACKEND_PROXY_TARGET=http://api:8000 (set in docker-compose.yml).

# --- Amazon Bedrock (no Claude required) ---
# 1) In AWS Console: Bedrock → Model access — enable the models you want (e.g. Titan, Llama, Mistral).
# 2) IAM: allow bedrock:InvokeModel (and InvokeModelWithResponseStream if you add streaming later)
#    on resource arn:aws:bedrock:<region>::foundation-model/* or specific model ARNs.
# 3) Set region + model ID from "Supported models" in Bedrock docs.

USE_BEDROCK=true
# Examples (us-east-1): google.gemma-3-12b-it | google.gemma-3-27b-it (if enabled in your account)
# | amazon.titan-text-express-v1 | meta.llama3-8b-instruct-v1:0 | mistral.mistral-7b-instruct-v0:2
BEDROCK_MODEL_ID=google.gemma-3-12b-it
# auto = infer from model id. For ARNs: set google_gemma | amazon_titan | meta_llama | mistral | anthropic
BEDROCK_PROVIDER=auto
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.3
BEDROCK_TOP_P=0.9

# DocuWeave PDF chunking
DOCUWEAVE_MAX_TOKENS=800
DOCUWEAVE_TOKEN_MODEL=gpt-4

DEFAULT_TOP_K=4
MAX_CONTEXT_CHUNKS=6
CONFIDENCE_THRESHOLD=0.35
